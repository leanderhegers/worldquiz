rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']);
    }

    match /usernames/{name} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /friendRequests/{reqId} {
      allow get: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // One doc per user per day, id `{date}_{uid}`. Only `create` is allowed (no update/delete), so
    // Firestore itself rejects a second submission for a date that already has a doc — that's what
    // makes the Daily Challenge's "once per day" rule hold even across devices/cleared local state.
    match /dailyScores/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        docId == request.resource.data.date + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // Multiplayer-Duelle (duel.js): 2-4 Spieler; nur Beteiligte sehen und aendern ein Duell.
    match /duels/{duelId} {
      allow create: if request.auth != null &&
        request.resource.data.host == request.auth.uid &&
        request.auth.uid in request.resource.data.players &&
        request.resource.data.players.size() <= 4;
      allow read, update, delete: if request.auth != null &&
        request.auth.uid in resource.data.players;
    }

    // Pruefseite fuer "Spass mit Flaggen" (spass-flaggen.html?pruefen=1): EIN Dokument mit nicht erratbarer ID. Wer die ID nicht kennt, kommt
    // nicht heran (kein list). Nur die Felder d (JSON-Text) und u (Zeit), hoechstens 200 KB. Nach der Pruefung kann dieser Block entfernt werden.
    match /flagFeedback/{docId} {
      allow get: if docId == 'pf-3c53b446e467a52cfce2';
      allow create, update: if docId == 'pf-3c53b446e467a52cfce2'
        && request.resource.data.keys().hasOnly(['d','u'])
        && request.resource.data.d is string
        && request.resource.data.d.size() < 200000;
    }
  }
}
